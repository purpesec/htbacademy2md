# Plantilla de configuración para htbacademy2md
#
# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env
#
# El archivo .env está incluido en .gitignore: tus cookies nunca se subirán al
# repositorio. Nunca compartas tu archivo .env con nadie.

# Cookies de HTB Academy. Obligatorio si no usas el flag -c.
# Cómo obtenerlas: inicia sesión en https://academy.hackthebox.com y copia la
# cookie htb_academy_session desde las DevTools (F12) -> Application/Storage -> Cookies.
HTB_COOKIES="htb_academy_session=VALOR; XSRF-TOKEN=VALOR"

# Idioma por defecto del contenido (opcional). Ej: es, fr, ja, ar, el, hi, zh.
# Vacío o ausente = contenido original en inglés.
HTB_LANG=es

# Descargar las imágenes localmente por defecto (opcional): true o false.
HTB_LOCAL_IMAGES=true
